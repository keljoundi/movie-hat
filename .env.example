# The Movie Hat Environment Configuration

# Server Port (default 3000)
PORT=3000

# Database path (optional - defaults to /srv/movies.db in Proxmox LXC or persistent ~/.movie-hat/movies.db)
# DB_PATH=/srv/movies.db

# JWT Secret for authentication session signing (optional, defaults to internal fallback)
# JWT_SECRET=your_super_secret_jwt_key_here

# Note: The TMDb API key is configured and managed directly in the web UI (First-run wizard or Settings page)
# and stored securely in SQLite. It does not need to be set in this .env file.
